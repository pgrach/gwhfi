# Safety interlock. Keep true until the relay wiring and command path are verified.
# Set DRY_RUN=false explicitly only when live heater control is approved.
DRY_RUN=true

# Octopus Agile scheduling
OCTOPUS_PRODUCT_CODE=AGILE-24-10-01
OCTOPUS_REGION_CODE=C
# Vercel dashboard equivalents; keep them identical to the controller values above.
NEXT_PUBLIC_OCTOPUS_PRODUCT_CODE=AGILE-24-10-01
NEXT_PUBLIC_OCTOPUS_REGION_CODE=C
LOCAL_TIMEZONE=Europe/London
DAILY_HEATING_BUDGET_HOURS=5
ABSOLUTE_MAX_PRICE=30
USE_BELOW_AVERAGE=true
BLOCKED_HOURS=[7,8,16,17,18]

# Route the off-peak/storage schedule to the Shelly Pro 1
STORAGE_HEATER_ENABLED=true
OFF_PEAK_HEATER_TARGET=second
SECOND_HEATER_CONTROL=shelly
SHELLY_RELAY_CHANNEL_SECOND=0
# Clamped to 120-300 seconds; 180 seconds is the recommended one-minute-loop lease.
SHELLY_CONTROL_LEASE_SECONDS=180

# Thermostat-cycle inference. Roll out as shadow first; only `live` may suppress
# a scheduled relay request after real heat and tank-satisfied evidence.
THERMOSTAT_CONTROL_MODE=off
THERMOSTAT_POWER_ON_THRESHOLD_W=2000
THERMOSTAT_POWER_OFF_THRESHOLD_W=100
THERMOSTAT_MIN_REAL_HEAT_MINUTES=10
THERMOSTAT_MIN_REAL_HEAT_WH=250
THERMOSTAT_LOW_SAMPLES_REQUIRED=2
THERMOSTAT_CHATTER_WINDOW_MINUTES=12
THERMOSTAT_MIN_CHATTER_TRANSITIONS=3
THERMOSTAT_MAX_TOPUP_BURST_MINUTES=3
THERMOSTAT_MIN_COOLDOWN_MINUTES=120
THERMOSTAT_MAX_DEFERRAL_MINUTES=240
THERMOSTAT_PROBE_SUCCESS_MINUTES=10
THERMOSTAT_PROBE_SHORT_MINUTES=3

# Shelly Cloud Control API (server-side secrets; never expose to the frontend)
SHELLY_CLOUD_SERVER=https://your-account-server.shelly.cloud
SHELLY_CLOUD_AUTH_KEY=
SHELLY_RELAY_DEVICE_ID=00700741fa34

# Existing Shelly energy meter used for dashboard telemetry
SHELLY_METER_DEVICE_ID=
# Stable provenance for fixed-cadence telemetry. Keep these unchanged across restarts.
TELEMETRY_SITE_ID=home
TELEMETRY_COLLECTOR_ID=railway-cloud-worker
# Vercel dashboard equivalents. Set these to the same values as Railway so
# every browser query and scoped downsampling RPC reads only this site/meter.
NEXT_PUBLIC_SHELLY_METER_DEVICE_ID=
NEXT_PUBLIC_TELEMETRY_SITE_ID=

# Supabase schedule and telemetry persistence
SUPABASE_URL=
# Server-only service_role secret; required for telemetry writes. Never expose
# this value through a NEXT_PUBLIC_* variable.
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Public read-only browser key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
